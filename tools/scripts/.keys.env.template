# .keys.env — recon / API provider keys (account-wide, not per-program).
# Copy to the repo root as .keys.env (gitignored) and fill in what you have.
# recon.sh and activate.sh source it, so these are exported for the tools that read env vars.
# Leave any you don't have blank — the tools skip a provider with no key.
#
# NOTE: subfinder and amass also read their OWN config files
#   subfinder: ~/.config/subfinder/provider-config.yaml
#   amass:     ~/.config/amass/config.ini
# Put keys there too if you use those tools directly; this file is the single place you keep them so a
# rebuild or a new machine is one copy away. Record the config paths in ENVIRONMENT.md.

# --- Passive DNS / subdomain sources ---
SHODAN_API_KEY=""
CENSYS_API_ID=""
CENSYS_API_SECRET=""
VIRUSTOTAL_API_KEY=""
SECURITYTRAILS_API_KEY=""
BINARYEDGE_API_KEY=""
CHAOS_API_KEY=""           # projectdiscovery chaos dataset
PDCP_API_KEY=""            # projectdiscovery cloud platform (nuclei/asnmap)

# --- Code / dork search ---
GITHUB_TOKEN=""            # github subdomain + secret dorking, amass
GITLAB_TOKEN=""

# --- OSINT / email / other ---
HUNTER_IO_API_KEY=""
INTELX_API_KEY=""
FOFA_EMAIL=""
FOFA_KEY=""

