# .session.env — per-program tokens and identity (gitignored — never commit)
# Copy to programs/<name>/.session.env and fill in. Load with: source tools/scripts/activate.sh <name>

# --- Platform (bugcrowd | hackerone | intigriti | yeswehack) ---
PLATFORM="bugcrowd"

# --- Target ---
TARGET_BASE_URL="https://app.example.com"

# --- Identity / traffic marking (must match the platform's requirement) ---
HUNTER_HANDLE="yourhandle"
HUNTER_UA="Mozilla/5.0 (compatible; BugBounty-Research; yourhandle@example.com)"
# Identifier header, name and value separately:
HUNTER_HEADER_NAME="X-Bug-Bounty"
HUNTER_HEADER_VALUE="yourhandle"

# --- Auth (fill after logging in via Burp; leave blank if unused) ---
AUTH_BEARER=""
SESSION_COOKIE=""
CSRF_TOKEN=""

# --- IDOR testing: two controlled accounts ---
ATTACKER_USER_ID=""
VICTIM_USER_ID=""
